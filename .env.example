# ============================================================
#  Airport Congestion Analytics — environment variables
#  Copy this file to .env 
#  docker compose reads it automatically.
# ============================================================

# ── Kafka ────────────────────────────────────────────────────
KAFKA_BROKER_ID=1
KAFKA_RETENTION_HOURS=2

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=airport_analytics
POSTGRES_USER=airport
POSTGRES_PASSWORD=airport123

# ── pgAdmin ──────────────────────────────────────────────────
PGADMIN_EMAIL=admin@airport.com
PGADMIN_PASSWORD=admin123

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ── OpenSky ──────────────────────────
OPENSKY_API_INTERVAL=60

# ── Bounding box: Alpine / Central Europe ────────────────────

BBOX_LAMIN=45.5
BBOX_LAMAX=48.5
BBOX_LOMIN=8.0
BBOX_LOMAX=16.0
