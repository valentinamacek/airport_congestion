{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["airport", "congestion"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Airport Congestion Analytics",
  "uid": "airport-congestion",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Congestion Score — busiest airports now",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "airport-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "airport-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.name AS airport, m.congestion_score FROM airport_metrics m JOIN airports a ON a.icao_code = m.airport_icao WHERE m.window_start = (SELECT max(window_start) FROM airport_metrics) ORDER BY m.congestion_score DESC;"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 70 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Arrivals vs Departures (latest minute)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "airport-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "airport-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.name AS airport, m.inbound_count AS arrivals, m.outbound_count AS departures FROM airport_metrics m JOIN airports a ON a.icao_code = m.airport_icao WHERE m.window_start = (SELECT max(window_start) FROM airport_metrics) ORDER BY a.name;"
        }
      ],
      "options": {
        "xField": "airport",
        "orientation": "auto",
        "stacking": "none",
        "showValue": "auto",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "legend": { "showLegend": true, "placement": "bottom", "displayMode": "list" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 80, "gradientMode": "none" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "arrivals" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "departures" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Congestion over time",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 8 },
      "datasource": { "type": "postgres", "uid": "airport-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "airport-postgres" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(m.window_start, '1m'), a.name AS metric, avg(m.congestion_score) AS congestion FROM airport_metrics m JOIN airports a ON a.icao_code = m.airport_icao WHERE $__timeFilter(m.window_start) GROUP BY 1, a.name ORDER BY 1;"
        }
      ],
      "options": {
        "legend": { "showLegend": true, "placement": "right", "displayMode": "list", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "scaleDistribution": { "type": "linear" }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Runway load (on / near-ground aircraft)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "postgres", "uid": "airport-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "airport-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.name AS airport, m.runway_load FROM airport_metrics m JOIN airports a ON a.icao_code = m.airport_icao WHERE m.window_start = (SELECT max(window_start) FROM airport_metrics) AND m.runway_load > 0 ORDER BY m.runway_load DESC;"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "lcd",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "geomap",
      "title": "Regional congestion heatmap",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "postgres", "uid": "airport-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "airport-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.name, a.latitude, a.longitude, m.congestion_score FROM airport_metrics m JOIN airports a ON a.icao_code = m.airport_icao WHERE m.window_start = (SELECT max(window_start) FROM airport_metrics);"
        }
      ],
      "options": {
        "view": { "id": "coords", "lat": 47.5, "lon": 12, "zoom": 5 },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": false,
          "showDebug": false,
          "showMeasure": false
        },
        "basemap": { "type": "default", "name": "Layer 0", "config": {} },
        "tooltip": { "mode": "details" },
        "layers": [
          {
            "type": "markers",
            "name": "Airports",
            "config": {
              "style": {
                "size": { "field": "congestion_score", "fixed": 5, "min": 6, "max": 30 },
                "color": { "field": "congestion_score", "fixed": "dark-red" },
                "opacity": 0.75,
                "symbol": { "mode": "fixed", "fixed": "img/icons/marker/circle.svg" },
                "textConfig": { "fontSize": 12, "offsetX": 0, "offsetY": -10, "textAlign": "center", "textBaseline": "middle" },
                "text": { "field": "name", "fixed": "" }
              },
              "showLegend": true
            },
            "location": { "mode": "coords", "latitude": "latitude", "longitude": "longitude" },
            "tooltip": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "continuous-GrYlRd" } },
        "overrides": []
      }
    }
  ]
}
